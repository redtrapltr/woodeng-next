{
  "compilerOptions": {
    /* ────────────────────────────────
       baseline settings (unchanged)
    ──────────────────────────────────*/
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    /* ▼ use the React 18 TS transform instead of leaving it to SWC
       (either "react-jsx" or keep "preserve" – pick ONE) */
    "jsx": "preserve",
    "incremental": true,
    /* React / Node typings so the TS server
       stops complaining about JSX & global types */
    "types": [
      "react",
      "react-dom",
      "node"
    ],
    /* Next.js plug-in  */
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* ────────────────────────────────
       path aliases
    ──────────────────────────────────*/
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/idl/*": [
        "./idl/*"
      ],
      "@/models/*": [
        "./src/models/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ],
      /* UI & profile components */
      "@/components/*": [
        "./src/contexts/components/*"
      ],
      "@/components/ui/*": [
        "./src/contexts/components/ui/*"
      ],
      "@/components/profile/*": [
        "./src/contexts/components/profile/*"
      ],
      /* profile-feature stores */
      "@/stores/*": [
        "./src/stores/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
